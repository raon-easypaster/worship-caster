# 설치 패키지 (npm install 로 다시 받음)
node_modules/

# 교회 자료·설정·업로드 파일·성경 본문 (개인 데이터, 저작권 본문 포함 가능)
data/

# 빌드된 앱 (이 맥의 폴더 경로가 들어 있음 → make-app.sh 로 다시 생성)
*.app/

# 개발 도구·시스템 파일
.claude/
.DS_Store
*.log

# 배포 파일 만들기
dist/
.build-cache/

# 찬송가 가사 파일은 저작권 때문에 저장소·배포판에 넣지 않음 (각자 컴퓨터에서만)
*찬송가*.json
hymns*.json

# 교독문 파일도 저작권 때문에 각자 컴퓨터에서만
